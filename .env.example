# Fresh Docker login when ADMIN_PASSWORD is empty:
# username: admin
# password: admin123!ChangeMe
# JARVIS forces a password change after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_SECRET=change-this-random-48-char-secret
FLASK_SECRET_KEY=change-this-too
JARVIS_ENCRYPTION_KEY=
JWT_TTL_SECONDS=43200
CORS_ALLOWED_ORIGINS=

GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
HF_SPACE_URL=

SLACK_WEBHOOK_URL=

WP_URL=
WP_USER=
WP_APP_PASSWORD=

HF_TOKEN=
HF_STORAGE_REPO=

JARVIS_DATA_DIR=/data
JARVIS_DB_PATH=/data/jarvis.db
JARVIS_LEGACY_DATA_DIR=/legacy/jarvis-data

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

MCP_HTTP_TIMEOUT_SECONDS=30
MCP_STDIO_TIMEOUT_SECONDS=20
