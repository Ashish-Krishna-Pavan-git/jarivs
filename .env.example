# ─── Admin Credentials ────────────────────────────────────────────────────────
# Default credentials for first-run login.
# JARVIS forces a password change after the first login if ADMIN_PASSWORD is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ─── Security Keys ────────────────────────────────────────────────────────────
# REQUIRED: Change both of these to random 48+ character strings before production use.
JWT_SECRET=change-this-random-48-char-secret
FLASK_SECRET_KEY=change-this-too

# Optional: Fernet encryption key for storing sensitive integration secrets in DB.
# If empty, integration credentials are stored in plaintext.
JARVIS_ENCRYPTION_KEY=

# JWT session duration in seconds (default: 12 hours)
JWT_TTL_SECONDS=43200

# Allowed CORS origins (comma-separated, e.g. https://mydomain.com,https://www.mydomain.com)
# Leave empty to allow all origins (development default).
CORS_ALLOWED_ORIGINS=

# ─── AI Providers ─────────────────────────────────────────────────────────────
# At least one AI provider is required for article analysis and summaries.
# JARVIS tries providers in priority order: Gemini → Groq → Ollama → Custom OpenAI
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# ─── Notifications ────────────────────────────────────────────────────────────
# Telegram bot token (from @BotFather) and chat ID for alerts and summaries.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# HuggingFace Space public URL (for keep-alive pings on HF deployments)
HF_SPACE_URL=

# Slack incoming webhook URL for mirroring alerts.
SLACK_WEBHOOK_URL=

# ─── WordPress Publishing ─────────────────────────────────────────────────────
# Publishes the daily intelligence report to your WordPress site.
# See docs/wordpress.md for full setup instructions.
#
# WP_URL          - Your WordPress site root URL (no trailing slash)
# WP_USER         - WordPress username (not email address)
# WP_APP_PASSWORD - Application Password from Users → Profile in WordPress admin
#                   (looks like: xxxx xxxx xxxx xxxx xxxx xxxx)
# WP_CATEGORY_ID  - Category ID to assign posts to (default: 1)
# WP_POST_STATUS  - "publish" for live posts, "draft" to review before publishing
# WP_TAGS         - Comma-separated tag IDs to attach (e.g. 12,34,56 — leave empty for none)
WP_URL=
WP_USER=
WP_APP_PASSWORD=
WP_CATEGORY_ID=1
WP_POST_STATUS=publish
WP_TAGS=

# ─── HuggingFace Dataset Storage ──────────────────────────────────────────────
# Syncs runtime state to a HuggingFace Dataset for persistence across HF Space restarts.
# Leave empty for Docker/local deployments where the volume persists.
HF_TOKEN=
HF_STORAGE_REPO=

# ─── Data Storage Paths ───────────────────────────────────────────────────────
# Override these in Docker Compose or when using a custom data directory.
# Defaults: /data (Docker) or /tmp/jarvis/data (local).
JARVIS_DATA_DIR=/data
JARVIS_DB_PATH=/data/jarvis.db
JARVIS_LEGACY_DATA_DIR=/legacy/jarvis-data

# ─── Ollama (Local AI) ────────────────────────────────────────────────────────
# Used as a fallback AI provider after Gemini and Groq.
# Pull model first: ollama pull phi4-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini

# ─── MCP (Model Context Protocol) ────────────────────────────────────────────
# Timeouts for MCP server connections.
MCP_HTTP_TIMEOUT_SECONDS=30
MCP_STDIO_TIMEOUT_SECONDS=20
